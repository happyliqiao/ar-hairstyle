/* 隐私授权弹窗。
   遮罩层级要比 tryon 的引导层（150）更高 —— 相机被隐私拦住时，
   引导层不会出现，但用户也可能在引导层没关的时候撞上这个，
   叠在最上面才不会被盖住。 */
.pg-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
}

.pg-card {
  width: 100%;
  box-sizing: border-box;
  background: #16161f;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 32rpx;
  padding: 44rpx 40rpx 32rpx;
  text-align: center;
}

.pg-icon {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0 auto 24rpx;
  border-radius: 44rpx;
  background: var(--gold-soft, rgba(224, 168, 111, 0.14));
  color: var(--gold, #e0a86f);
  font-size: 40rpx;
}

.pg-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text, #f2f0ee);
  margin-bottom: 20rpx;
}

/* 正文用左对齐：这是一段要读的说明，居中对齐每行长度不一，
   读起来眼睛要来回找行首 */
.pg-desc {
  display: block;
  text-align: left;
  font-size: 26rpx;
  line-height: 42rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 24rpx;
}

.pg-link {
  display: block;
  text-align: left;
  font-size: 25rpx;
  line-height: 44rpx;
  color: var(--gold, #e0a86f);
  margin-bottom: 28rpx;
}

.pg-btn {
  width: 100%;
  box-sizing: border-box;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  font-size: 30rpx;
  text-align: center;
  margin: 0 0 16rpx;
}

/* 微信 button 自带边框和背景，必须清掉才能和设计对齐 */
.pg-btn::after {
  border: none;
}

.pg-btn-main {
  background: linear-gradient(135deg, #f2cb9a, #c0854c);
  color: #1a1208;
  font-weight: 600;
}

.pg-btn-ghost {
  background: transparent;
  color: var(--text-mute, #6a6979);
  font-size: 27rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin-bottom: 0;
}
